@misc{bhattacharjee_sublinear_2022,
	title = {Sublinear {Time} {Eigenvalue} {Approximation} via {Random} {Sampling}},
	url = {http://arxiv.org/abs/2109.07647},
	doi = {10.48550/arXiv.2109.07647},
	abstract = {We study the problem of approximating the eigenspectrum of a symmetric matrix \${\textbackslash}mathbf A {\textbackslash}in {\textbackslash}mathbb\{R\}{\textasciicircum}\{n {\textbackslash}times n\}\$ with bounded entries (i.e., \${\textbackslash}{\textbar}{\textbackslash}mathbf A{\textbackslash}{\textbar}\_\{{\textbackslash}infty\} {\textbackslash}leq 1\$). We present a simple sublinear time algorithm that approximates all eigenvalues of \${\textbackslash}mathbf\{A\}\$ up to additive error \${\textbackslash}pm {\textbackslash}epsilon n\$ using those of a randomly sampled \${\textbackslash}tilde \{O\}{\textbackslash}left ({\textbackslash}frac\{{\textbackslash}log{\textasciicircum}3 n\}\{{\textbackslash}epsilon{\textasciicircum}3\}{\textbackslash}right ) {\textbackslash}times {\textbackslash}tilde O{\textbackslash}left ({\textbackslash}frac\{{\textbackslash}log{\textasciicircum}3 n\}\{{\textbackslash}epsilon{\textasciicircum}3\}{\textbackslash}right )\$ principal submatrix. Our result can be viewed as a concentration bound on the complete eigenspectrum of a random submatrix, significantly extending known bounds on just the singular values (the magnitudes of the eigenvalues). We give improved error bounds of \${\textbackslash}pm {\textbackslash}epsilon {\textbackslash}sqrt\{{\textbackslash}text\{nnz\}({\textbackslash}mathbf\{A\})\}\$ and \${\textbackslash}pm {\textbackslash}epsilon {\textbackslash}{\textbar}{\textbackslash}mathbf A{\textbackslash}{\textbar}\_F\$ when the rows of \${\textbackslash}mathbf A\$ can be sampled with probabilities proportional to their sparsities or their squared \${\textbackslash}ell\_2\$ norms respectively. Here \${\textbackslash}text\{nnz\}({\textbackslash}mathbf\{A\})\$ is the number of non-zero entries in \${\textbackslash}mathbf\{A\}\$ and \${\textbackslash}{\textbar}{\textbackslash}mathbf A{\textbackslash}{\textbar}\_F\$ is its Frobenius norm. Even for the strictly easier problems of approximating the singular values or testing the existence of large negative eigenvalues (Bakshi, Chepurko, and Jayaram, FOCS '20), our results are the first that take advantage of non-uniform sampling to give improved error bounds. From a technical perspective, our results require several new eigenvalue concentration and perturbation bounds for matrices with bounded entries. Our non-uniform sampling bounds require a new algorithmic approach, which judiciously zeroes out entries of a randomly sampled submatrix to reduce variance, before computing the eigenvalues of that submatrix as estimates for those of \${\textbackslash}mathbf A\$. We complement our theoretical results with numerical simulations, which demonstrate the effectiveness of our algorithms in practice.},
	language = {en},
	urldate = {2025-08-09},
	publisher = {arXiv},
	author = {Bhattacharjee, Rajarshi and Dexter, Gregory and Drineas, Petros and Musco, Cameron and Ray, Archan},
	month = jul,
	year = {2022},
	note = {arXiv:2109.07647 [cs]},
	keywords = {Computer Science - Data Structures and Algorithms, Computer Science - Numerical Analysis, Mathematics - Numerical Analysis},
}

@article{martinsson_randomized_2020,
