	doi = {10.48550/arXiv.1909.07515},
	abstract = {We show that the span of \$Ω({\textbackslash}frac\{1\}\{{\textbackslash}varepsilon{\textasciicircum}4\})\$ rows of any matrix \$A {\textbackslash}subset {\textbackslash}mathbb\{R\}{\textasciicircum}\{n {\textbackslash}times d\}\$ sampled according to the length-squared distribution contains a rank-\$1\$ matrix \${\textbackslash}tilde\{A\}\$ such that \${\textbar}{\textbar}A - {\textbackslash}tilde\{A\}{\textbar}{\textbar}\_F{\textasciicircum}2 {\textbackslash}leq (1 + {\textbackslash}varepsilon) {\textbackslash}cdot {\textbar}{\textbar}A - π\_1(A){\textbar}{\textbar}\_F{\textasciicircum}2\$, where \$π\_1(A)\$ denotes the best rank-\$1\$ approximation of \$A\$ under the Frobenius norm. Length-squared sampling has previously been used in the context of rank-\$k\$ approximation. However, the approximation obtained was additive in nature. We obtain a multiplicative approximation albeit only for rank-\$1\$ approximation.},
	language = {en},
	urldate = {2026-04-29},
	publisher = {arXiv},
	author = {Jaiswal, Ragesh and Kumar, Amit},
	month = oct,
	year = {2019},
	note = {arXiv:1909.07515 [cs]},
