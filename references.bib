	doi = {10.48550/arXiv.1303.4207},
	abstract = {The CUR matrix decomposition and the Nystro¨m approximation are two important lowrank matrix approximation techniques. The Nystro¨m method approximates a symmetric positive semideﬁnite matrix in terms of a small number of its columns, while CUR approximates an arbitrary data matrix by a small number of its columns and rows. Thus, CUR decomposition can be regarded as an extension of the Nystr¨om approximation.},
	language = {en},
