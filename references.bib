}

@misc{musco_recursive_2017,
	title = {Recursive {Sampling} for the {Nyström} {Method}},
	url = {http://arxiv.org/abs/1605.07583},
	doi = {10.48550/arXiv.1605.07583},
	abstract = {We give the ﬁrst algorithm for kernel Nystr¨om approximation that runs in linear time in the number of training points and is provably accurate for all kernel matrices, without dependence on regularity or incoherence conditions. The algorithm projects the kernel onto a set of s landmark points sampled by their ridge leverage scores, requiring just O(ns) kernel evaluations and O(ns2) additional runtime. While leverage score sampling has long been known to give strong theoretical guarantees for Nystr¨om approximation, by employing a fast recursive sampling scheme, our algorithm is the ﬁrst to make the approach scalable. Empirically we show that it ﬁnds more accurate, lower rank kernel approximations in less time than popular techniques such as uniformly sampled Nystr¨om approximation and the random Fourier features method.},
	language = {en},
	urldate = {2025-08-06},
	publisher = {arXiv},
	author = {Musco, Cameron and Musco, Christopher},
	month = nov,
	year = {2017},
	note = {arXiv:1605.07583 [cs]},
	keywords = {Computer Science - Data Structures and Algorithms, Computer Science - Machine Learning, Statistics - Machine Learning},
}

@misc{musco_sublinear_2019,
	title = {Sublinear {Time} {Low}-{Rank} {Approximation} of {Positive} {Semidefinite} {Matrices}},
	url = {http://arxiv.org/abs/1704.03371},
	doi = {10.48550/arXiv.1704.03371},
	abstract = {We show how to compute a relative-error low-rank approximation to any positive semidefinite (PSD) matrix in sublinear time, i.e., for any \$n {\textbackslash}times n\$ PSD matrix \$A\$, in \${\textbackslash}tilde O(n {\textbackslash}cdot poly(k/{\textbackslash}epsilon))\$ time we output a rank-\$k\$ matrix \$B\$, in factored form, for which \${\textbackslash}{\textbar}A-B{\textbackslash}{\textbar}\_F{\textasciicircum}2 {\textbackslash}leq (1+{\textbackslash}epsilon){\textbackslash}{\textbar}A-A\_k{\textbackslash}{\textbar}\_F{\textasciicircum}2\$, where \$A\_k\$ is the best rank-\$k\$ approximation to \$A\$. When \$k\$ and \$1/{\textbackslash}epsilon\$ are not too large compared to the sparsity of \$A\$, our algorithm does not need to read all entries of the matrix. Hence, we significantly improve upon previous \$nnz(A)\$ time algorithms based on oblivious subspace embeddings, and bypass an \$nnz(A)\$ time lower bound for general matrices (where \$nnz(A)\$ denotes the number of non-zero entries in the matrix). We prove time lower bounds for low-rank approximation of PSD matrices, showing that our algorithm is close to optimal. Finally, we extend our techniques to give sublinear time algorithms for low-rank approximation of \$A\$ in the (often stronger) spectral norm metric \${\textbackslash}{\textbar}A-B{\textbackslash}{\textbar}\_2{\textasciicircum}2\$ and for ridge regression on PSD matrices.},
	language = {en},
	urldate = {2025-08-06},
	publisher = {arXiv},
	author = {Musco, Cameron and Woodruff, David P.},
	month = jan,
	year = {2019},
	note = {arXiv:1704.03371 [cs]},
	keywords = {Computer Science - Data Structures and Algorithms, Computer Science - Machine Learning, Mathematics - Numerical Analysis},
}

