@article{chen_randomly_2025,
	title = {Randomly pivoted {Cholesky}: {Practical} approximation of a kernel matrix with few entry evaluations},
	volume = {78},
	issn = {1097-0312},
	shorttitle = {Randomly pivoted {Cholesky}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/cpa.22234},
	doi = {10.1002/cpa.22234},
	abstract = {The randomly pivoted Cholesky algorithm (RPCholesky) computes a factorized rank-{\textbackslash}k{\textbackslash} approximation of an {\textbackslash}N {\textbackslash}times N{\textbackslash} positive-semidefinite (psd) matrix. RPCholesky requires only {\textbackslash}(k + 1)N{\textbackslash} entry evaluations and {\textbackslash}mathcal O(k{\textasciicircum}2 N){\textbackslash} additional arithmetic operations, and it can be implemented with just a few lines of code. The method is particularly useful for approximating a kernel matrix. This paper offers a thorough new investigation of the empirical and theoretical behavior of this fundamental algorithm. For matrix approximation problems that arise in scientific machine learning, experiments show that RPCholesky matches or beats the performance of alternative algorithms. Moreover, RPCholesky provably returns low-rank approximations that are nearly optimal. The simplicity, effectiveness, and robustness of RPCholesky strongly support its use in scientific computing and machine learning applications.},
	language = {en},
	number = {5},
	urldate = {2025-08-06},
	journal = {Communications on Pure and Applied Mathematics},
	author = {Chen, Yifan and Epperly, Ethan N. and Tropp, Joel A. and Webber, Robert J.},
	year = {2025},
	pages = {995--1041},
}

